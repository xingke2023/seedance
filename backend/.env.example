# Azure TTS
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastasia

# AI Storyboard (DeepSeek)
STORYBOARD_API_KEY=your_deepseek_api_key
STORYBOARD_API_URL=https://api.deepseek.com
STORYBOARD_MODEL=deepseek-chat

# Volcengine Ark (Seedance video generation)
ARK_API_KEY=your_ark_api_key

# Server
PORT=3200
WEBHOOK_BASE_URL=http://localhost:3200

# Upload directory (optional, defaults to ./uploads)
# UPLOAD_DIR=/path/to/uploads

# Prompt Engine (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://tokens.fidelityai.net
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe 订阅支付
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=hkd
# 三档套餐的 Price ID，用 node scripts/stripe-setup-plans.js 生成
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ULTRA=price_xxx
# Checkout 付款完成后跳回的站点地址
APP_BASE_URL=https://meeaws.xingke888.com
# 一次性次数包（支付宝/微信只能用于一次性付款）
STRIPE_PRICE_PACK100=price_xxx
STRIPE_PRICE_PACK300=price_xxx
STRIPE_PRICE_PACK800=price_xxx
